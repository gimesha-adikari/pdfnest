# PDFNest Frontend Environment Configuration
# Copy this file to .env.local for local development

# Public API & Application Endpoints
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-Side Email Domain
MAIL_DOMAIN=example.com

# Public Third-Party Integration Credentials (Non-Secret)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=<google-oauth-client-id>
NEXT_PUBLIC_PADDLE_LIVE_CLIENT_TOKEN=<paddle-client-token>
NEXT_PUBLIC_PADDLE_ENV=sandbox

NEXT_PUBLIC_DIRECT_R2_UPLOAD=true
NEXT_PUBLIC_R2_PRESIGN_ENDPOINT=http://localhost:8080/api/storage/r2/presign

NEXT_PUBLIC_OCR_JOB_CREATE_ENDPOINT=http://localhost:8080/api/ocr/jobs

WORKER_SHARED_SECRET=<worker-shared-secret>

