import assert from 'node:assert/strict';
import {createHash,webcrypto} from 'node:crypto';
import fs from 'node:fs';
import ts from 'typescript';
import {createRequire} from 'node:module';
import React,{act} from 'react';
import {verifiedCandidateWords} from '../../lib/verifiedCandidateWords';
const require=createRequire(import.meta.url);
const data=new Blob(['%PDF-1.7 candidate']);
const digest=createHash('sha256').update(Buffer.from(await data.arrayBuffer())).digest('hex');
const text='අධ්‍යාපනය';
const metadata={version:'platen_candidate_words.v1',artifact_sha256:digest,pages:[{page_num:1,width:595,height:842,words:[{text,rect:[60,100,150,124],representation:'verified_raster_word',selection:'whole_word'}]}]};
Object.defineProperty(globalThis,'crypto',{value:webcrypto,configurable:true});
assert.equal((await verifiedCandidateWords(data,digest,metadata))[0].words[0].text,text);
assert.deepEqual(await verifiedCandidateWords(new Blob(['different']),digest,metadata),[]);
assert.deepEqual(await verifiedCandidateWords(data,'0'.repeat(64),metadata),[]);
assert.deepEqual(await verifiedCandidateWords(data,digest,{...metadata,pages:[{...metadata.pages[0],words:[metadata.pages[0].words[0],metadata.pages[0].words[0]]}]}),[]);
assert.deepEqual(await verifiedCandidateWords(data,digest,{...metadata,pages:[{...metadata.pages[0],words:[{...metadata.pages[0].words[0],text:'unsafe\u202e'}]}]}),[]);
const jsdom='jsdom';const {JSDOM}=await import(jsdom);
const dom=new JSDOM('<div id="root"></div>',{url:'http://localhost/'});
Object.assign(globalThis,{window:dom.window,document:dom.window.document,HTMLElement:dom.window.HTMLElement,IS_REACT_ACT_ENVIRONMENT:true});
const src=fs.readFileSync('components/tools/CandidateWordSelection.tsx','utf8');
const {outputText}=ts.transpileModule(src,{compilerOptions:{module:ts.ModuleKind.CommonJS,jsx:ts.JsxEmit.ReactJSX,esModuleInterop:true}});
const module={exports:{}};
let delay:((pages:unknown)=>void)|null=null;
let delayed=false;
new Function('require','module','exports',outputText)((name:string)=>name==='@/lib/verifiedCandidateWords'?{verifiedCandidateWords:async(...args:any[])=>delayed?new Promise(resolve=>{delay=resolve;}):verifiedCandidateWords(args[0],args[1],args[2])}:require(name),module,module.exports);
const Component=(module.exports as any).default;
const {createRoot}=await import('react-dom/client');const root=createRoot(document.getElementById('root')!);
const file=new File([await data.arrayBuffer()],'candidate.pdf');
async function render(fileArg=file,meta:any=metadata,page=1){await act(async()=>{root.render(React.createElement(Component,{file:fileArg,metadata:meta,artifactSha256:digest,page,imageSrc:"blob:verified"}));});await act(async()=>{await new Promise(r=>setTimeout(r,20));});}
await render();
const checkbox=document.querySelector('input[type=checkbox]') as HTMLInputElement;assert.ok(checkbox);
await act(async()=>checkbox.click());
const word=document.querySelector('[data-candidate-word]') as HTMLElement;assert.equal(word.textContent,text);assert.equal(word.getAttribute('role'),'button');
await act(async()=>word.dispatchEvent(new dom.window.KeyboardEvent('keydown',{key:'Enter',bubbles:true})));
assert.equal(window.getSelection()?.toString(),text,'keyboard selection must read candidate Unicode including ZWJ');
const partial=new dom.window.KeyboardEvent('keydown',{key:'ArrowLeft',shiftKey:true,bubbles:true,cancelable:true});
await act(async()=>word.dispatchEvent(partial));assert.ok(partial.defaultPrevented,'unqualified partial selection is disabled');
assert.equal(document.querySelectorAll('[data-candidate-word]').length,1,'no duplicate text node');
await render();assert.equal(document.querySelectorAll('[data-candidate-word]').length,1,'normal rerender preserves selectable candidate');
const next=new File(['other'],'candidate.pdf');delayed=true;
await render(next);
assert.equal(document.querySelectorAll('[data-candidate-word]').length,0,'different bytes must immediately remove old words');
await render(file);const oldResolve=delay!;
await render(next);await act(async()=>{oldResolve(metadata.pages);await new Promise(r=>setTimeout(r,5));});
assert.equal(document.querySelectorAll('[data-candidate-word]').length,0,'stale extraction cannot leak old candidate text');
await act(async()=>root.unmount());
console.log('Candidate-bound whole-word selection, Unicode, malformed metadata, invalidation, and stale response tests passed.');
